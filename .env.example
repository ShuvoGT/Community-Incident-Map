# ── Database (PostgreSQL + PostGIS) ──────────────────────────────
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://incidents:incidents@localhost:5432/incidents

# ── Redis (background worker queue) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (S3-compatible; MinIO in dev) ─────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=incident-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Signed-link lifetime for private evidence, in seconds.
S3_SIGNED_URL_TTL=120

# ── Map tiles & geocoding (licensed provider, server-proxied) ────
# Never sent to the browser directly; proxy through our API with quota + cache.
MAP_PROVIDER=maptiler
MAP_TILES_API_KEY=
GEOCODE_API_KEY=

# ── Contact verification (OTP) ───────────────────────────────────
# "email" (default) or "sms". Both adapters exist; one is active.
VERIFICATION_CHANNEL=email
SMTP_URL=
SMS_PROVIDER_API_KEY=

# ── App ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
# App timezone for occurrence dates/display. System timestamps stay UTC.
APP_TIMEZONE=Asia/Dhaka
# Encryption key for private contact fields (32-byte base64). Generate per env.
CONTACT_ENCRYPTION_KEY=
